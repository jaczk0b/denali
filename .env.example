# Denali — konfiguracja. Skopiuj do .env i dopisz klucz:  python -m denali genkeys >> .env
# .env NIE trafia do repozytorium. Jego kopię trzymaj w menedżerze haseł — bez DENALI_ENCRYPTION_KEY
# zaszyfrowane dane (skarbiec, tokeny integracji, 2FA) są nie do odczytania, także z kopii zapasowej.

# Szyfrowanie sekretów w bazie (Fernet)
DENALI_ENCRYPTION_KEY=

# Adres IP Nginx Proxy Managera (jedyny, któremu panel wierzy w nagłówku X-Forwarded-For z adresem klienta).
# Od tego zależy limit prób logowania i przypięcie tabletu do adresu. Jeśli w Audycie przy logowaniu widzisz adres
# NPM zamiast swojego — ten wpis jest zły.
DENALI_TRUSTED_PROXIES=["192.168.1.2"]

# Port, na którym panel słucha na tej VM (cel proxy hosta w NPM)
DENALI_PORT=8000

# Adres panelu (do linków w powiadomieniach)
DENALI_BASE_URL=https://denali.serwispowers.com

# Katalog danych na hoście (baza, pliki, kopie, eksport). Musi należeć do UID 1000. W Komodo podaj stałą ścieżkę.
DENALI_DATA_PATH=/opt/denali/data

# Tryb deweloperski (NIE na produkcji): działa po HTTP bez kluczy, włącza opis API pod /docs
DENALI_DEV=0
